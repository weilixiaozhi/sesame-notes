# Web 静态页面与 API 反向代理的配置示例。
# 替换域名及路径，并令 API 的 CORS_ORIGINS 包含 https://app.example.com。
app.example.com {
    encode zstd gzip
    root * /srv/sesame-notes/web/current

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }

    # 保留 /api 前缀；含浏览器认证、文件下载和 WebSocket 升级。
    handle /api/* {
        reverse_proxy 127.0.0.1:8080
    }

    # Vite 带哈希产物长期缓存，缺失资源必须返回 404 而非 HTML。
    handle /assets/* {
        @existing file
        header @existing Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # React 路由刷新回落 index.html；入口始终重新验证。
    handle {
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}
