# prod 环境模板：运行时使用 deploy/.env.prod。
# 每条 Compose 命令显式使用 --env-file deploy/.env.prod；先核实库名和实际卷挂载。
# NODE_ENV=production 由 prod Compose 设置，无需在这里重复。
SESAME_ENV=prod
POSTGRES_PASSWORD=replace-with-the-existing-production-password
# 密码必须 URI 编码；主机 postgres 是当前 prod Compose 服务名。
DATABASE_URL=postgresql://sesame:replace-with-uri-encoded-password@postgres:5432/sesame_notes_prod?connection_limit=10&pool_timeout=20
# 首次部署由初始化脚本生成随机密钥；已有部署必须保留原值，重启和升级时不要重新生成。
JWT_SECRET=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# 浏览器 Cookie 登录必须填写完整且精确的网页 HTTPS Origin（同源反代也需要）。
CORS_ORIGINS=
# Admin 浏览器入口的完整 HTTPS Origin；与应用用户来源分别配置。
ADMIN_ORIGINS=
ADMIN_SESSION_TTL=28800
ADMIN_SESSION_IDLE_TTL=1800
TRUST_PROXY_CIDRS=172.16.0.0/12
# 应用内更新仓库，格式为 owner/repo；留空关闭更新入口。
GITHUB_RELEASE_REPOSITORY=
# 私有更新仓库需要只读 Token；公开仓库可留空。
GITHUB_RELEASE_TOKEN=
# 镜像标签后缀必须为已核实的不可变发布标识；纯命名只为当前运行镜像创建 prod 别名。
PROD_IMAGE_TAG=
# 当前已运行 PostgreSQL 镜像 ID 的裸 64 位 sha256；创建同一镜像的 prod 别名，勿拉取升级。
POSTGRES_IMAGE_REVISION=
