generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 性别：仅本人可见，不进入共享成员响应；默认 UNSPECIFIED
enum UserGender {
  UNSPECIFIED
  MALE
  FEMALE
}

// 成员类型：REGISTERED 绑定云账号（id 由 uuidV5 派生）；PLACEHOLDER 无账号的占位成员（未注册参与人）
enum LedgerMemberType {
  REGISTERED
  PLACEHOLDER
}

// 成员角色：owner 为账本 Owner 的一等成员身份，editor 为协作角色（邀请即编辑）
enum LedgerMemberRole {
  owner
  editor
}

// 成员生命周期：LEFT/REMOVED 永久保留历史身份但无云访问权限，仅 ACTIVE 可访问
enum LedgerMemberStatus {
  ACTIVE
  LEFT
  REMOVED
}

model ProductAnalyticsEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorKey      String   @map("actor_key") @db.Char(64)
  eventId       String   @map("event_id") @db.Uuid
  kind          String   @db.VarChar(24)
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(3)
  receivedAt    DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  platform      String?  @db.VarChar(8)
  pageId        String?  @map("page_id") @db.VarChar(96)
  appVersion    String?  @map("app_version") @db.VarChar(64)
  eventName     String?  @map("event_name") @db.VarChar(128)
  sessionId     String?  @map("session_id") @db.Uuid
  eventSequence Int?     @map("event_sequence")
  flowId        String?  @map("flow_id") @db.Uuid
  bannerSlot    String?  @map("banner_slot") @db.VarChar(64)
  bannerSource  String?  @map("banner_source") @db.VarChar(16)
  bannerVersion Int?     @map("banner_version")
  bannerId      String?  @map("banner_id") @db.VarChar(96)

  @@unique([actorKey, eventId])
  @@index([occurredAt, kind])
  @@index([platform, occurredAt, kind])
  @@index([actorKey, occurredAt])
  @@index([eventName, occurredAt])
  @@index([sessionId, actorKey, occurredAt])
  @@index([flowId, actorKey, occurredAt])
  @@index([bannerSlot, bannerSource, bannerVersion, occurredAt], map: "product_analytics_banner_dimension_time_idx")
  @@index([bannerId, bannerSlot, bannerSource, bannerVersion, occurredAt], map: "product_analytics_banner_slide_time_idx")
  @@map("product_analytics_events")
}

model ProductAnalyticsState {
  id              Int      @id
  startedAt       DateTime @map("started_at") @db.Timestamptz(3)
  bannerStartedAt DateTime @default(now()) @map("banner_started_at") @db.Timestamptz(3)

  @@map("product_analytics_state")
}

model OfficialFitnessContent {
  id        String   @id @db.VarChar(128)
  kind      String   @db.VarChar(16)
  version   Int      @default(1)
  content   Json     @db.JsonB
  isEnabled Boolean  @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  @@index([kind, updatedAt(sort: Desc), id])
  @@map("official_fitness_content")
}

model OfficialFitnessState {
  id             Int @id @default(1)
  contentVersion Int @default(1) @map("content_version")

  @@map("official_fitness_state")
}

model OfficialFitnessTaxon {
  kind      String    @db.VarChar(16)
  id        String    @db.VarChar(100)
  nameZh    String    @map("name_zh") @db.VarChar(100)
  nameHant  String    @map("name_hant") @db.VarChar(100)
  nameEn    String    @map("name_en") @db.VarChar(200)
  version   Int       @default(1)
  sortOrder Int       @default(0) @map("sort_order")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?   @map("updated_by") @db.VarChar(100)

  @@id([kind, id])
  @@index([kind, deletedAt, sortOrder, id])
  @@map("official_fitness_taxonomies")
}

model OfficialFitnessMedia {
  id        String   @id @db.VarChar(64)
  fileName  String   @map("file_name") @db.VarChar(255)
  mimeType  String   @map("mime_type") @db.VarChar(64)
  byteSize  Int      @map("byte_size")
  width     Int
  height    Int
  frames    Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.VarChar(100)

  @@map("official_fitness_media")
}

model AppBanner {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slot      String          @db.VarChar(64)
  imageId   String?         @map("image_id") @db.VarChar(64)
  image     AppBannerMedia? @relation(fields: [imageId], references: [id], onDelete: Restrict)
  target    String          @db.VarChar(64)
  targetId  String?         @map("target_id") @db.VarChar(128)
  isEnabled Boolean         @default(false) @map("is_enabled")
  version   Int             @default(1)
  sortOrder Int             @default(0) @map("sort_order")
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz(3)
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?         @map("updated_by") @db.VarChar(100)

  @@index([imageId, isEnabled])
  @@index([slot, deletedAt, isEnabled, sortOrder, id], map: "app_banners_slot_display_idx")
  @@map("app_banners")
}

model AppBannerMedia {
  id        String      @id @db.VarChar(64)
  fileName  String      @map("file_name") @db.VarChar(200)
  byteSize  Int         @map("byte_size")
  width     Int
  height    Int
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?     @map("created_by") @db.VarChar(100)
  banners   AppBanner[]

  @@map("app_banner_media")
}

model AdminAccount {
  id                  String         @id @default(uuid()) @db.Uuid
  username            String         @unique @db.VarChar(32)
  email               String?        @unique @db.VarChar(254)
  phone               String?        @unique @db.VarChar(16)
  displayName         String         @map("display_name") @db.VarChar(100)
  passwordHash        String         @map("password_hash") @db.VarChar(255)
  identityType        String         @default("standard_user") @map("identity_type") @db.VarChar(32)
  groupId             String         @default("a0000000-0000-4000-8000-000000000000") @map("group_id") @db.Uuid
  group               AdminGroup     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  version             Int            @default(1)
  isEnabled           Boolean        @default(true) @map("is_enabled")
  failedLoginAttempts Int            @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?      @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime?      @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy           String?        @map("created_by") @db.VarChar(100)
  updatedBy           String?        @map("updated_by") @db.VarChar(100)
  deletedBy           String?        @map("deleted_by") @db.VarChar(100)
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz(3)
  sessions            AdminSession[]

  @@index([identityType, isEnabled, deletedAt])
  @@index([groupId, deletedAt])
  @@map("admin_accounts")
}

model AdminGroup {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(100)
  description String         @default("") @db.VarChar(500)
  sort        Int            @default(0)
  isEnabled   Boolean        @default(true) @map("is_enabled")
  permissions String[]       @default([])
  pageIds     String[]       @default([]) @map("page_ids")
  version     Int            @default(1)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   String?        @map("created_by") @db.VarChar(100)
  updatedBy   String?        @map("updated_by") @db.VarChar(100)
  deletedBy   String?        @map("deleted_by") @db.VarChar(100)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(3)
  accounts    AdminAccount[]

  @@index([deletedAt, sort])
  @@map("admin_groups")
}

model AdminSession {
  id         String       @id @default(uuid()) @db.Uuid
  adminId    String       @map("admin_id") @db.Uuid
  tokenHash  String       @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime?    @map("revoked_at") @db.Timestamptz(3)
  ip         String?      @db.VarChar(64)
  userAgent  String?      @map("user_agent") @db.VarChar(512)
  admin      AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, revokedAt])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model User {
  id               String                 @id @default(uuid()) @db.Uuid
  // 登录凭据：E.164 规范化字符串，唯一索引是并发防线
  phoneE164        String                 @unique @map("phone_e164") @db.VarChar(16)
  // 9 位芝麻号（100000000-999999999，无前导零）：全局唯一、不可修改
  sesameNumber     String                 @unique @map("sesame_number") @db.Char(9)
  passwordHash     String                 @map("password_hash") @db.VarChar(255)
  // 管理员换绑或重置密码时递增，旧访问令牌不能随同设备重新登录而恢复。
  credentialVersion Int                  @default(0) @map("credential_version")
  isEnabled        Boolean                @default(true) @map("is_enabled")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  profile          UserProfile?
  devices          Device[]
  refreshTokens    RefreshToken[]
  ownedLedgers     Ledger[]               @relation("LedgerOwner")
  dayBooks         DayBook[]
  memoBooks        MemoBook[]
  fitnessSpaces    FitnessSpace[]
  memberships      LedgerMember[]
  categoryConflicts CategoryConflict[]
  categories       Category[]
  rateOverrides    ExchangeRateOverride[]
  authoredChanges  SyncChange[]           @relation("ChangeAuthor")
  recipientChanges SyncChange[]           @relation("ChangeRecipient")
  idempotencyKeys  IdempotencyKey[]
  mutationReservations MutationReservation[]
  createdInvites   LedgerInvite[]         @relation("InviteCreator")
  usedInvites      LedgerInvite[]         @relation("InviteUsedBy")

  @@map("users")
}

// 同步来源按账号与设备占用，跨设备确认命令按账号占用；均不受 HTTP 回执过期影响。
enum MutationReservationScope {
  device
  account
}

model MutationReservation {
  scope       MutationReservationScope
  userId      String @map("user_id") @db.Uuid
  scopeId     String @map("scope_id") @db.Uuid
  mutationId  String @map("mutation_id") @db.Uuid
  requestHash String @map("request_hash") @db.Char(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([scope, userId, scopeId, mutationId])
  @@index([userId, mutationId])
  @@map("mutation_reservations")
}

// 私有空间与其他父本使用相同的账号归属、绑定代际及内容时间。
model FitnessSpace {
  id        String @id @db.Uuid
  ownerId   String @map("owner_id") @db.Uuid
  name      String @db.Text
  syncId    String @default(uuid()) @map("sync_id") @db.Uuid
  revision  Int @default(1)
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  owner     User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  entities  FitnessEntity[]

  @@index([ownerId, deletedAt, updatedAt(sort: Desc), id])
  @@map("fitness_spaces")
}

// 四类内容属于空间；删除计划不级联删除训练。
model FitnessEntity {
  id          String   @id @db.Uuid
  fitnessSpaceId String @map("fitness_space_id") @db.Uuid
  entityType  String   @map("entity_type") @db.VarChar(64)
  revision    Int      @default(1)
  payload     Json     @db.JsonB
  status      String?  @db.VarChar(32)
  occurrenceKey String? @map("occurrence_key") @db.VarChar(255)
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  space       FitnessSpace @relation(fields: [fitnessSpaceId], references: [id], onDelete: Cascade)
  references  FitnessEntityReference[]

  @@index([fitnessSpaceId, entityType, id])
  @@unique([fitnessSpaceId, occurrenceKey])
  @@map("fitness_entities")
}

// 来源引用由数据库从完整 JSON 派生，目标可晚到或已删除，因此 targetId 不建立目标外键。
model FitnessEntityReference {
  entityId String @map("entity_id") @db.Uuid
  targetId String @map("target_id") @db.Uuid
  entity   FitnessEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([entityId, targetId])
  @@index([targetId, entityId])
  @@map("fitness_entity_references")
}

model UserProfile {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String     @unique @map("user_id") @db.Uuid
  displayName       String?    @map("display_name") @db.VarChar(100)
  gender            UserGender @default(UNSPECIFIED)
  avatarFileId      String?    @map("avatar_file_id") @db.VarChar(128)
  avatarVersion     Int        @default(0) @map("avatar_version")
  themePrimaryColor String?    @map("theme_primary_color") @db.VarChar(7)
  appearance        Json?
  aiConfig          Json?      @map("ai_config")
  primaryCurrency   String?    @map("primary_currency") @db.VarChar(16)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Device {
  id                           String                 @id @default(uuid()) @db.Uuid
  userId                       String                 @map("user_id") @db.Uuid
  // App 安装标识：同一安装在不同账号下对应不同服务端 device；账号注册/登录必填
  installationId               String                 @map("installation_id") @db.Uuid
  name                         String                 @default("Unknown Device") @db.VarChar(128)
  platform                     String                 @default("unknown") @db.VarChar(32)
  appVersion                   String?                @map("app_version") @db.VarChar(64)
  osVersion                    String?                @map("os_version") @db.VarChar(64)
  deviceModel                  String?                @map("device_model") @db.VarChar(128)
  lastIp                       String?                @map("last_ip") @db.VarChar(64)
  lastSeenAt                   DateTime               @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt                    DateTime?              @map("revoked_at") @db.Timestamptz(3)
  createdAt                    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  user                         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens                RefreshToken[]
  updatedLedgers               Ledger[]               @relation("LedgerUpdatedByDevice")
  updatedTransactions          Transaction[]          @relation("TransactionUpdatedByDevice")
  updatedRecurringTransactions RecurringTransaction[] @relation("RecurringUpdatedByDevice")
  updatedCategories            Category[]             @relation("CategoryUpdatedByDevice")
  updatedRateOverrides         ExchangeRateOverride[] @relation("RateUpdatedByDevice")
  updatedMembers               LedgerMember[]         @relation("LedgerMemberUpdatedByDevice")
  archivedMembers              LedgerMember[]         @relation("LedgerMemberArchiveUpdatedByDevice")
  updatedDayEvents             DayEvent[]

  @@unique([id, userId])
  @@unique([userId, installationId])
  @@index([userId, revokedAt])
  @@map("devices")
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  deviceId       String    @map("device_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  // 签发时的 auth generation（随机 UUID）：轮换后旧令牌整体失效；
  // 随机值不会循环回历史值
  authGeneration String    @default(uuid()) @map("auth_generation") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  device         Device    @relation(fields: [deviceId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, deviceId])
  @@map("refresh_tokens")
}

model Ledger {
  id                    String                 @id @default(uuid()) @db.Uuid
  // 云同步时间线身份：同一云端账本的所有设备共享同一 sync_id；
  // 服务端在 REST 创建或 push 首建时生成，更新时保留；客户端首次绑定后保存此身份。
  syncId                String                 @unique @map("sync_id") @db.Uuid
  ownerId               String                 @map("owner_id") @db.Uuid
  name                  String                 @db.VarChar(255)
  currency              String                 @default("CNY") @db.VarChar(16)
  monthStartDay         Int                    @default(1) @map("month_start_day")
  aaEnabled             Boolean                @default(false) @map("aa_enabled")
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByDeviceId     String?                @map("updated_by_device_id") @db.Uuid
  deletedAt             DateTime?              @map("deleted_at") @db.Timestamptz(3)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  owner                 User                   @relation("LedgerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  updatedByDevice       Device?                @relation("LedgerUpdatedByDevice", fields: [updatedByDeviceId], references: [id], onDelete: SetNull)
  members               LedgerMember[]
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  changes               SyncChange[]
  invites               LedgerInvite[]

  @@unique([id, ownerId])
  @@index([ownerId, deletedAt])
  @@map("ledgers")
}

model LedgerMember {
  id                       String                   @id @db.Uuid
  ledgerId                 String                   @map("ledger_id") @db.Uuid
  // 账本级身份快照：脱离 Account 也能解释历史成员是谁（首次创建时从 User.profile 快照）
  displayName              String                   @map("display_name") @db.VarChar(100)
  memberType               LedgerMemberType         @map("member_type")
  // REGISTERED 绑定云账号；PLACEHOLDER 无账号（NULL 允许多个，不参与 unique 兜底）
  // 删除账号通过accounts用例先解除成员关联，保留共享账本中的历史身份与引用。
  linkedAccountId          String?                  @map("linked_account_id") @db.Uuid
  role                     LedgerMemberRole
  status                   LedgerMemberStatus       @default(ACTIVE)
  // 个人归档使用独立版本，不能推进共享成员资料与生命周期的版本。
  archivedAt               DateTime?                @map("archived_at") @db.Timestamptz(3)
  archiveUpdatedAt         DateTime?                @map("archive_updated_at") @db.Timestamptz(3)
  archiveUpdatedByDeviceId String?                  @map("archive_updated_by_device_id") @db.Uuid
  joinedAt                 DateTime                 @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByDeviceId        String?                  @map("updated_by_device_id") @db.Uuid
  ledger                   Ledger                   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  linkedAccount            User?                    @relation(fields: [linkedAccountId], references: [id], onDelete: NoAction)
  updatedByDevice          Device?                  @relation("LedgerMemberUpdatedByDevice", fields: [updatedByDeviceId], references: [id], onDelete: SetNull)
  archiveUpdatedByDevice   Device?                  @relation("LedgerMemberArchiveUpdatedByDevice", fields: [archiveUpdatedByDeviceId], references: [id], onDelete: SetNull)
  createdTransactions      Transaction[]            @relation("TransactionCreatedByMember")
  lastEditedTransactions   Transaction[]            @relation("TransactionLastEditedByMember")
  paidTransactions         Transaction[]            @relation("TransactionPayerMember")
  splitRows                TransactionSplit[]       @relation("TransactionSplitMember")
  editOperations           TransactionEditHistory[] @relation("TransactionEditOperatorMember")

  // 领域不变量兜底：同一 (ledgerId, linkedAccountId) 最多一个成员（NULL 允许多个，PLACEHOLDER 不冲突）
  @@unique([ledgerId, linkedAccountId])
  @@unique([id, ledgerId])
  @@index([ledgerId, status])
  @@index([linkedAccountId])
  @@map("ledger_members")
}

model LedgerInvite {
  id          String    @id @default(uuid()) @db.Uuid
  codeHash    String    @unique @map("code_hash") @db.VarChar(64)
  codePrefix  String    @map("code_prefix") @db.VarChar(8)
  ledgerId    String    @map("ledger_id") @db.Uuid
  createdById String    @map("created_by_id") @db.Uuid
  role        String    @default("editor") @db.VarChar(16)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  usedById    String?   @map("used_by_id") @db.Uuid
  // 作废标记：REMOVE 成员时把账本内未消费邀请置为失效（usedAt 保持 NULL，语义不混淆）
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  ledger      Ledger    @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy      User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([ledgerId, expiresAt])
  @@map("ledger_invites")
}

model Transaction {
  id                   String                   @id @default(uuid()) @db.Uuid
  ledgerId             String                   @map("ledger_id") @db.Uuid
  ownerId              String                   @map("owner_id") @db.Uuid
  txType               String                   @map("tx_type") @db.VarChar(16)
  amount               Decimal                  @db.Decimal(38, 10)
  happenedAt           DateTime                 @map("happened_at") @db.Timestamptz(3)
  note                 String?
  categoryId           String?                  @map("category_id") @db.Uuid
  categoryName         String?                  @map("category_name")
  categoryKind         String?                  @map("category_kind") @db.VarChar(16)
  currencyCode         String                   @map("currency_code") @db.VarChar(16)
  nativeAmount         Decimal                  @map("native_amount") @db.Decimal(38, 10)
  recurringId          String?                  @map("recurring_id") @db.Uuid
  occurrenceDate       String?                  @map("occurrence_date") @db.VarChar(10)
  // 账本级成员引用（双端命名统一 createdByMemberId/lastEditedByMemberId/payerMemberId）；
  // createdBy 由认证推导（不信任 payload），payer/splits 输入校验后写入
  createdByMemberId    String?                  @map("created_by_member_id") @db.Uuid
  lastEditedByMemberId String?                  @map("last_edited_by_member_id") @db.Uuid
  payerMemberId        String?                  @map("payer_member_id") @db.Uuid
  aaMode               Int?                     @map("aa_mode")
  // 服务端权威乐观并发版本，用于 CAS 更新。
  revision             Int                      @default(1)
  lastEditedAt         DateTime?                @map("last_edited_at") @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByDeviceId    String?                  @map("updated_by_device_id") @db.Uuid
  deletedAt            DateTime?                @map("deleted_at") @db.Timestamptz(3)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  ledger               Ledger                   @relation(fields: [ledgerId, ownerId], references: [id, ownerId], onDelete: Cascade, onUpdate: NoAction, map: "transactions_ledger_owner_fkey")
  createdByMember      LedgerMember?            @relation("TransactionCreatedByMember", fields: [createdByMemberId, ledgerId], references: [id, ledgerId], onDelete: NoAction, onUpdate: NoAction, map: "transaction_created_by_member_fkey")
  lastEditedByMember   LedgerMember?            @relation("TransactionLastEditedByMember", fields: [lastEditedByMemberId, ledgerId], references: [id, ledgerId], onDelete: NoAction, onUpdate: NoAction, map: "transaction_last_edited_by_member_fkey")
  payerMember          LedgerMember?            @relation("TransactionPayerMember", fields: [payerMemberId, ledgerId], references: [id, ledgerId], onDelete: NoAction, onUpdate: NoAction, map: "transaction_payer_member_fkey")
  updatedByDevice      Device?                  @relation("TransactionUpdatedByDevice", fields: [updatedByDeviceId], references: [id], onDelete: SetNull)
  category             Category?                @relation(fields: [categoryId, ownerId], references: [id, ownerId], onDelete: NoAction, onUpdate: NoAction, map: "transactions_category_owner_fkey")
  recurring            RecurringTransaction?    @relation(fields: [recurringId, ledgerId], references: [id, ledgerId], onDelete: NoAction, onUpdate: NoAction, map: "transactions_recurring_ledger_fkey")
  editHistory          TransactionEditHistory[]
  splits               TransactionSplit[]

  @@unique([id, ledgerId])
  @@index([ledgerId, happenedAt, id])
  @@index([categoryId])
  @@index([recurringId])
  @@unique([recurringId, occurrenceDate])
  @@map("transactions")
}

model TransactionEditHistory {
  id               String        @id @default(uuid()) @db.Uuid
  transactionId    String        @map("transaction_id") @db.Uuid
  ledgerId         String        @map("ledger_id") @db.Uuid
  version          Int
  // 操作者成员引用（双端命名 operatorMemberId）
  operatorMemberId String?       @map("operator_member_id") @db.Uuid
  changes          Json
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  transaction      Transaction   @relation(fields: [transactionId, ledgerId], references: [id, ledgerId], onDelete: Cascade, onUpdate: NoAction, map: "transaction_edit_history_transaction_ledger_fkey")
  operatorMember   LedgerMember? @relation("TransactionEditOperatorMember", fields: [operatorMemberId, ledgerId], references: [id, ledgerId], onDelete: NoAction, onUpdate: NoAction, map: "transaction_edit_operator_member_fkey")

  @@unique([transactionId, version])
  @@index([ledgerId])
  @@map("transaction_edit_history")
}

model TransactionSplit {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String       @map("transaction_id") @db.Uuid
  ledgerId      String       @map("ledger_id") @db.Uuid
  // 参与人单轨成员引用（REGISTERED 派生 v5 / PLACEHOLDER 占位成员 id）
  memberId      String       @map("member_id") @db.Uuid
  amount        Decimal      @db.Decimal(38, 10)
  transaction   Transaction  @relation(fields: [transactionId, ledgerId], references: [id, ledgerId], onDelete: Cascade, onUpdate: NoAction, map: "transaction_splits_transaction_id_fkey")
  member        LedgerMember @relation("TransactionSplitMember", fields: [memberId, ledgerId], references: [id, ledgerId], onDelete: Restrict, onUpdate: NoAction, map: "transaction_split_member_fkey")

  @@unique([transactionId, memberId])
  @@map("transaction_splits")
}

model RecurringTransaction {
  id                String        @id @default(uuid()) @db.Uuid
  ledgerId          String        @map("ledger_id") @db.Uuid
  ownerId           String        @map("owner_id") @db.Uuid
  txType            String        @map("tx_type") @db.VarChar(16)
  amount            Decimal       @db.Decimal(38, 10)
  currencyCode      String        @map("currency_code") @db.VarChar(16)
  categoryId        String?       @map("category_id") @db.Uuid
  note              String?
  frequency         String        @db.VarChar(16)
  interval          Int           @default(1)
  dayOfMonth        Int?          @map("day_of_month")
  dayOfWeek         Int?          @map("day_of_week")
  monthOfYear       Int?          @map("month_of_year")
  startDate         DateTime      @map("start_date") @db.Timestamptz(3)
  endDate           DateTime?     @map("end_date") @db.Timestamptz(3)
  lastGeneratedDate DateTime?     @map("last_generated_date") @db.Timestamptz(3)
  protocolVersion   Int           @default(1) @map("protocol_version")
  timeZone          String        @default("UTC") @map("time_zone") @db.VarChar(100)
  enabled           Boolean       @default(true)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByDeviceId String?       @map("updated_by_device_id") @db.Uuid
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  ledger            Ledger        @relation(fields: [ledgerId, ownerId], references: [id, ownerId], onDelete: Cascade, onUpdate: NoAction, map: "recurring_transactions_ledger_owner_fkey")
  updatedByDevice   Device?       @relation("RecurringUpdatedByDevice", fields: [updatedByDeviceId], references: [id], onDelete: SetNull)
  category          Category?     @relation(fields: [categoryId, ownerId], references: [id, ownerId], onDelete: NoAction, onUpdate: NoAction, map: "recurring_transactions_category_owner_fkey")
  transactions      Transaction[]

  @@unique([id, ledgerId])
  @@index([ledgerId, deletedAt])
  @@index([categoryId])
  @@map("recurring_transactions")
}

model Category {
  // 分类身份由 (id, owner_id) 共同确定，不同账号可以持有相同模板派生的分类 ID。
  id                    String                 @default(uuid()) @db.Uuid
  ownerId               String                 @map("owner_id") @db.Uuid
  name                  String
  kind                  String                 @db.VarChar(16)
  level                 Int                    @default(1)
  sortOrder             Int                    @default(0) @map("sort_order")
  icon                  String?                @db.VarChar(255)
  parentId              String?                @map("parent_id") @db.Uuid
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByDeviceId     String?                @map("updated_by_device_id") @db.Uuid
  deletedAt             DateTime?              @map("deleted_at") @db.Timestamptz(3)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  owner                 User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  updatedByDevice       Device?                @relation("CategoryUpdatedByDevice", fields: [updatedByDeviceId], references: [id], onDelete: SetNull)
  parent                Category?              @relation("CategoryTree", fields: [parentId, ownerId], references: [id, ownerId], onDelete: NoAction, onUpdate: NoAction, map: "categories_parent_owner_fkey")
  children              Category[]             @relation("CategoryTree")
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  conflicts             CategoryConflict[]

  @@id([id, ownerId])
  @@index([ownerId, deletedAt, kind, sortOrder])
  @@map("categories")
}

// 冲突候选是不可见的待确认意图；不作为可选分类，也不按名称认领自定义身份。
model CategoryConflict {
  id                   String   @id @default(uuid()) @db.Uuid
  ownerId              String   @map("owner_id") @db.Uuid
  categoryId           String   @map("category_id") @db.Uuid
  templateKey          String   @map("template_key") @db.VarChar(128)
  sourceDeviceId       String   @map("source_device_id") @db.Uuid
  sourceMutationId     String   @map("source_mutation_id") @db.Uuid
  requestHash          String   @map("request_hash") @db.Char(64)
  candidateVersion     Int      @default(1) @map("candidate_version")
  action               String   @db.VarChar(16)
  localPayload         Json     @map("local_payload") @db.JsonB
  localUpdatedAt       DateTime @map("local_updated_at") @db.Timestamptz(3)
  status               String   @default("pending") @db.VarChar(16)
  resolution           String?  @db.VarChar(16)
  resolutionMutationId String?  @map("resolution_mutation_id") @db.Uuid
  resolutionHash       String?  @map("resolution_hash") @db.Char(64)
  resolutionResult     Json?    @map("resolution_result") @db.JsonB
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt           DateTime? @map("resolved_at") @db.Timestamptz(3)
  owner                User     @relation(fields: [ownerId], references: [id], onDelete: Cascade, map: "category_conflicts_owner_fkey")
  category             Category @relation(fields: [categoryId, ownerId], references: [id, ownerId], onDelete: Cascade, map: "category_conflicts_category_fkey")

  @@unique([ownerId, sourceDeviceId, sourceMutationId], map: "category_conflicts_source_key")
  @@unique([ownerId, resolutionMutationId], map: "category_conflicts_resolution_key")
  @@index([ownerId, status, createdAt(sort: Desc), id], map: "category_conflicts_owner_status_page_idx")
  @@map("category_conflicts")
}

model ExchangeRateOverride {
  id                String    @id @default(uuid()) @db.Uuid
  ownerId           String    @map("owner_id") @db.Uuid
  baseCurrency      String    @map("base_currency") @db.VarChar(16)
  quoteCurrency     String    @map("quote_currency") @db.VarChar(16)
  rate              Decimal   @db.Decimal(38, 18)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByDeviceId String?   @map("updated_by_device_id") @db.Uuid
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)
  owner             User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  updatedByDevice   Device?   @relation("RateUpdatedByDevice", fields: [updatedByDeviceId], references: [id], onDelete: SetNull)

  @@unique([ownerId, baseCurrency, quoteCurrency])
  @@index([ownerId, deletedAt])
  @@map("exchange_rate_overrides")
}

model SyncChange {
  changeId        BigInt   @id @default(autoincrement()) @map("change_id")
  // 删除账号通过accounts用例先清理私有事件，其他共享账本的历史事件保留并解除作者关联。
  userId          String?  @map("user_id") @db.Uuid
  ledgerId        String?  @map("ledger_id") @db.Uuid
  dayBookId       String?  @map("day_book_id") @db.Uuid
  memoBookId      String?  @map("memo_book_id") @db.Uuid
  fitnessSpaceId  String? @map("fitness_space_id") @db.Uuid
  scope           String   @db.VarChar(16)
  entityType      String   @map("entity_type") @db.VarChar(64)
  entityId        String   @map("entity_id") @db.Uuid
  action          String   @db.VarChar(16)
  mutationId      String   @map("mutation_id") @db.Uuid
  requestHash     String?  @map("request_hash") @db.VarChar(64)
  payload         Json @db.Json
  updatedAt       DateTime @map("updated_at") @db.Timestamptz(3)
  deviceId        String   @map("device_id") @db.Uuid
  // 撤权后账本关系已不可见，定向接收者仍须拉到自己的最终成员状态
  recipientUserId String?  @map("recipient_user_id") @db.Uuid
  user            User?    @relation("ChangeAuthor", fields: [userId], references: [id], onDelete: SetNull)
  recipientUser   User?    @relation("ChangeRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  ledger          Ledger?  @relation(fields: [ledgerId], references: [id], onDelete: SetNull)

  @@unique([deviceId, mutationId])
  @@index([userId, changeId])
  @@index([userId, mutationId])
  @@index([ledgerId, changeId])
  @@index([dayBookId, changeId])
  @@index([memoBookId, changeId])
  @@index([fitnessSpaceId, changeId])
  @@index([recipientUserId, changeId])
  @@map("sync_changes")
}

// 日子本拥有独立时间线与实体版本，记录的账号身份仅从父本继承。
model DayBook {
  id        String     @id @default(uuid()) @db.Uuid
  ownerId   String     @map("owner_id") @db.Uuid
  name      String     @db.Text
  syncId    String     @default(uuid()) @map("sync_id") @db.Uuid
  revision  Int        @default(1)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(3)
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  events    DayEvent[]

  @@index([ownerId, deletedAt])
  @@map("day_books")
}

// 原始日期与公历投影分列保存，每个可空日期端点必须整组存在或整组为空。
model DayEvent {
  id                 String    @id @default(uuid()) @db.Uuid
  dayBookId          String    @map("day_book_id") @db.Uuid
  name               String    @db.Text
  category           String    @db.Text
  countdownMode      String?   @map("countdown_mode") @db.Text
  intervalDays       Int?      @map("interval_days")
  repeatType         String    @map("repeat_type") @db.Text
  statisticType      String    @map("statistic_type") @db.Text
  eventCalendarType  String?   @map("event_calendar_type") @db.Text
  eventOriginalYear  Int?      @map("event_original_year")
  eventOriginalMonth Int?      @map("event_original_month")
  eventOriginalDay   Int?      @map("event_original_day")
  eventIsLeapMonth   Boolean?  @map("event_is_leap_month")
  eventSolarDate     DateTime? @map("event_solar_date") @db.Date
  startCalendarType  String?   @map("start_calendar_type") @db.Text
  startOriginalYear  Int?      @map("start_original_year")
  startOriginalMonth Int?      @map("start_original_month")
  startOriginalDay   Int?      @map("start_original_day")
  startIsLeapMonth   Boolean?  @map("start_is_leap_month")
  startSolarDate     DateTime? @map("start_solar_date") @db.Date
  endCalendarType    String?   @map("end_calendar_type") @db.Text
  endOriginalYear    Int?      @map("end_original_year")
  endOriginalMonth   Int?      @map("end_original_month")
  endOriginalDay     Int?      @map("end_original_day")
  endIsLeapMonth     Boolean?  @map("end_is_leap_month")
  endSolarDate       DateTime? @map("end_solar_date") @db.Date
  revision           Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)
  updatedByDeviceId  String?   @map("updated_by_device_id") @db.Uuid
  dayBook            DayBook   @relation(fields: [dayBookId], references: [id], onDelete: Cascade)
  updatedByDevice    Device?   @relation(fields: [updatedByDeviceId], references: [id], onDelete: SetNull)

  @@index([dayBookId, deletedAt, category])
  @@index([dayBookId, deletedAt, createdAt, id])
  @@map("day_events")
}

// 内容时间由客户端保存/恢复携带，不使用 @updatedAt 重写历史时间。
model MemoBook {
  id        String      @id @db.Uuid
  ownerId   String      @map("owner_id") @db.Uuid
  name      String      @db.Text
  type      String      @db.Text
  syncId    String      @default(uuid()) @map("sync_id") @db.Uuid
  revision  Int         @default(1)
  createdAt DateTime    @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?   @map("deleted_at") @db.Timestamptz(3)
  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  entries   MemoEntry[]

  @@unique([id, type])
  @@index([ownerId, deletedAt, updatedAt(sort: Desc), id])
  @@map("memo_books")
}

model MemoEntry {
  id         String    @id @db.Uuid
  memoBookId String    @map("memo_book_id") @db.Uuid
  bookType   String    @map("book_type") @db.Text
  // 标题与正文使用 JSON 承载原始字符，接口仍只接受和返回字符串标题。
  title      Json      @db.Json
  bodyFormat String?   @map("body_format") @db.Text
  // JSON 而非 JSONB 可原样承载正文转义的 U+0000；卡片字段列表同样落在正文里。
  body       Json?     @db.Json
  orderKey   BigInt?   @map("order_key")
  revision   Int       @default(1)
  createdAt  DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  book       MemoBook  @relation(fields: [memoBookId, bookType], references: [id, type], onDelete: Cascade)

  @@index([memoBookId, deletedAt, createdAt(sort: Desc), id])
  @@index([memoBookId, deletedAt, orderKey, id])
  @@map("memo_entries")
}

model IdempotencyKey {
  id          BigInt   @id @default(autoincrement())
  userId      String   @map("user_id") @db.Uuid
  key         String   @db.VarChar(128)
  requestHash String   @map("request_hash") @db.VarChar(64)
  response    Json
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  // 写入时的幂等 generation（随机 UUID）：轮换后历史键整体失效；
  // 随机值不会循环回历史值
  generation  String   @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model ServerEpoch {
  id                    Int       @id @default(0)
  // 认证 generation（随机 UUID）：轮换后所有旧 refresh token 立即失效；
  // 随机值不会循环回历史值
  authGeneration        String    @default(uuid()) @map("auth_generation") @db.Uuid
  // 幂等 generation（随机 UUID）：轮换后历史幂等键整体失效；
  // 轮换后重放的请求按新请求处理，不被旧键吞掉
  idempotencyGeneration String    @default(uuid()) @map("idempotency_generation") @db.Uuid
  // 一次性协议切换水位；null 表示存量数据库尚未完成显式停写确认。
  syncCutoverCursor     BigInt?   @map("sync_cutover_cursor")
  syncCutoverAt         DateTime? @map("sync_cutover_at") @db.Timestamptz(3)
  // 物理清理事件前保存的已提交全局下界，保证其他账号已取得的快照游标不会倒退。
  syncCursorFloor       BigInt    @default(0) @map("sync_cursor_floor")
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("server_epochs")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actor     String   @db.VarChar(255)
  action    String   @db.VarChar(128)
  target    Json
  requestId String   @map("request_id") @db.VarChar(128)
  ip        String?  @db.VarChar(64)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
