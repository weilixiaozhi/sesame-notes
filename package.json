{
  "name": "sesame-notes",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "pnpm -r build",
    "version:bump": "node scripts/build-tools/bump-version.mjs",
    "test": "pnpm --filter @sesame-notes/api test && pnpm --filter @sesame-notes/api-client test && pnpm --filter @sesame-notes/web test && pnpm --filter @sesame-notes/admin test",
    "dev:web": "pnpm --filter @sesame-notes/api-client build && pnpm --filter @sesame-notes/web dev",
    "dev:web:preview": "pwsh -NoProfile -File scripts/dev/start-test-environment.ps1 -Component web",
    "dev:test": "pwsh -NoProfile -File scripts/dev/start-test-environment.ps1",
    "dev:test:init": "pwsh -NoProfile -File scripts/dev/init-test-environment.ps1",
    "sync:catalogs": "node scripts/maintenance/sync-mobile-catalogs.mjs",
    "import:catalogs": "node scripts/maintenance/import-mobile-catalogs.mjs",
    "sync:web:currencies": "node scripts/maintenance/sync-mobile-catalogs.mjs currencies",
    "sync:web:categories": "node scripts/maintenance/sync-mobile-catalogs.mjs categories",
    "test:web:backend": "pwsh -NoProfile -File scripts/dev/test-web-backend.ps1",
    "test:mobile:backend": "pwsh -NoProfile -File scripts/dev/test-mobile-backend.ps1",
    "test:rules": "node --test --test-randomize eslint-rules/module-public-entry.test.mjs eslint-rules/sync-change-writes.test.mjs \"scripts/test/*.test.mjs\"",
    "test:scripts": "pnpm test:rules && python -B scripts/test/run.py",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze:deps": "node scripts/check/analyze-deps.mjs",
    "contract:check": "node scripts/check/contract-check.mjs",
    "admin:dev": "pnpm --filter @sesame-notes/api-client build && pnpm --filter @sesame-notes/admin dev",
    "admin:preview": "pwsh -NoProfile -File scripts/dev/start-test-environment.ps1 -Component admin",
    "admin:build": "pnpm --filter @sesame-notes/api-client build && pnpm --filter @sesame-notes/admin build",
    "admin:test": "pnpm --filter @sesame-notes/admin test"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "type": "module",
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "all"
  }
}
