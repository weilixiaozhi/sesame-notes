# 换行符归一化策略
#
# 文本入库统一存储 LF；工作区的换行符由下方各类文件规则明确指定。

# 默认：让 git 自动判定文本/二进制，文本入库统一转 LF
* text=auto eol=lf

# 源码与配置：显式声明为文本并强制 LF
*.ts     text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.prisma text eol=lf
*.sql    text eol=lf
*.lock   text eol=lf

# Shell 脚本必须是 LF，否则在 Linux/macOS 上无法执行
*.sh     text eol=lf

# Windows 脚本保持 CRLF
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# 二进制资源：禁止任何换行符转换与 diff
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
