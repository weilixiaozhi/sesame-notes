# test 环境模板：新 clone 运行 pnpm dev:test:init 生成仓库根 .env.test 与随机 JWT 密钥。
# 已有环境手动配置时保留原凭据与镜像身份，测试入口显式加载此文件。
# 本文件只保存应用配置，不允许 COMPOSE_* 或 DOCKER_* 控制变量；项目名由启动入口固定。
# prod 使用 deploy/.env.prod.example。
# NODE_ENV 是 Node.js 运行模式，test 的热重载 API 使用 development。
# pnpm dev:test 的数据库初始化在后台账号表为空时创建 superadmin / superadmin，已有账号保持原样。
SESAME_ENV=test
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
# 本地配置保存手机可访问的测试 API 地址；既有后端验收必须显式确认并匹配这两个来源。
# API 仅允许回环或私有 IPv4 HTTP；Web 使用可信回环来源，端口同步列入 CORS_ORIGINS。
TEST_API_ORIGIN=http://127.0.0.1:8080
TEST_WEB_ORIGIN=http://127.0.0.1:4173
# 连接池固定为 10 条连接、排队窗口 20s：覆盖最长事务（同步事务 15s 上限），
# 不按宿主机核数放大默认连接数，避免多实例时撞上 PostgreSQL max_connections
DATABASE_URL=postgresql://sesame:sesame@127.0.0.1:55432/sesame_notes_test?connection_limit=10&pool_timeout=20
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
STORAGE_PATH=./data
EXCHANGE_RATE_UPSTREAM=https://api.frankfurter.dev
EXCHANGE_RATE_CACHE_TTL=43200
# CORS 与认证 Cookie 来源白名单（逗号分隔，完整协议/主机/端口）；同源浏览器也须列入，留空仅支持非 Cookie 客户端
CORS_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1:5173
# Admin 独立 Cookie 会话的来源白名单；本地开发只允许 localhost 使用 HTTP。
ADMIN_ORIGINS=http://localhost:55174,http://localhost:5174
ADMIN_SESSION_TTL=28800
ADMIN_SESSION_IDLE_TTL=1800
# 全局限流（次/分钟）与敏感接口限流（登录/刷新/注册/邀请接受）
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
# 增量游标有效下限；更旧游标返回 410，0 不触发过期；此配置不执行历史清理
SYNC_RETENTION_MIN_CURSOR=0
# 可信反向代理网段（逗号分隔的 IP/CIDR，只信任宿主机反向代理如宿主机 Nginx）；留空 = 不信任任何转发头
TRUST_PROXY_CIDRS=
# 更新仓库使用 owner/repo 格式；留空关闭应用内更新入口。
GITHUB_RELEASE_REPOSITORY=
# 私有仓库使用仅授予该仓库 Contents: Read 的 Token；公开仓库可留空。
GITHUB_RELEASE_TOKEN=

# 首次初始化从公开官方 PostgreSQL 17 镜像记录本地 Image ID 的裸 64 位 sha256，并创建 test 别名。
# 已有环境使用当前镜像 ID，不能填仓库 RepoDigest 或通过初始化升级；TEST_BOOTSTRAP_ID 由初始化生成。
POSTGRES_IMAGE_REVISION=
TEST_IMAGE_TAG=local
# 相对 deploy/ 的源码目录，或明确指定的测试工作树绝对路径。
TEST_SOURCE_ROOT=..
